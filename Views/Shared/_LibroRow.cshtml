@model Biblioteca.Web.Models.Libro

<tr>
    <td class="fw-medium">@Html.DisplayFor(modelItem => Model.Titulo)</td>
    <td><code>@Html.DisplayFor(modelItem => Model.ISBN)</code></td>
    <td>
        <span class="badge bg-secondary">
            <i class="fas fa-user-edit me-1"></i>@Html.DisplayFor(modelItem => Model.NombreAutor)
        </span>
    </td>
    <td>
        <span class="badge bg-dark">
            <i class="fas fa-layer-group me-1"></i>@Html.DisplayFor(modelItem => Model.Ejemplares)
        </span>
    </td>
    <td>
        <div class="action-buttons text-center">
            <a asp-action="Edit" asp-route-id="@Model.LibroId" class="btn btn-warning btn-sm" title="Editar">
                <i class="fas fa-edit"></i>
            </a>
            <a asp-action="Details" asp-route-id="@Model.LibroId" class="btn btn-info btn-sm" title="Detalles">
                <i class="fas fa-eye"></i>
            </a>
            <a asp-action="Delete" asp-route-id="@Model.LibroId" class="btn btn-danger btn-sm" title="Eliminar">
                <i class="fas fa-trash"></i>
            </a>
        </div>
    </td>
</tr>
