@model Biblioteca.Web.Models.Libro

@{
    ViewData["Title"] = "Editar Libro";
}

<div class="container-fluid">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">
                <i class="fas fa-edit text-warning me-2"></i>Editar Libro
            </h1>
            <p class="text-muted mb-0">Modifica los datos del libro</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>Volver al Listado
        </a>
    </div>

    <!-- Formulario -->
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-book me-2"></i>Información del Libro
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>Por favor, corrija los siguientes errores:
                        </div>
                        <input type="hidden" asp-for="LibroId" />

                        <div class="mb-3">
                            <label asp-for="Titulo" class="form-label">
                                <i class="fas fa-heading me-1"></i>Título
                            </label>
                            <input asp-for="Titulo" class="form-control" placeholder="Ingrese el título del libro" />
                            <span asp-validation-for="Titulo" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ISBN" class="form-label">
                                <i class="fas fa-barcode me-1"></i>ISBN
                            </label>
                            <input asp-for="ISBN" class="form-control" placeholder="Ingrese el ISBN" />
                            <span asp-validation-for="ISBN" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AutorId" class="form-label">
                                <i class="fas fa-user me-1"></i>Autor
                            </label>
                            <select asp-for="AutorId" class="form-control" asp-items="ViewBag.Autores">
                                <option value="">-- Seleccionar Autor --</option>
                            </select>
                            <span asp-validation-for="AutorId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Ejemplares" class="form-label">
                                <i class="fas fa-copy me-1"></i>Número de Ejemplares
                            </label>
                            <input asp-for="Ejemplares" class="form-control" type="number" min="1" placeholder="Ingrese la cantidad" />
                            <span asp-validation-for="Ejemplares" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times me-1"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save me-1"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
