@model Biblioteca.Web.Models.Libro

@{
    ViewData["Title"] = "Detalles del Libro";
}

<div class="container-fluid">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">
                <i class="fas fa-info-circle text-info me-2"></i>Detalles del Libro
            </h1>
            <p class="text-muted mb-0">Información completa del libro</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>Volver al Listado
        </a>
    </div>

    <!-- Detalles -->
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-book me-2"></i>Información del Libro
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">
                            <i class="fas fa-heading me-1"></i>Título
                        </dt>
                        <dd class="col-sm-8 fw-medium">@Html.DisplayFor(model => model.Titulo)</dd>

                        <dt class="col-sm-4 text-muted">
                            <i class="fas fa-barcode me-1"></i>ISBN
                        </dt>
                        <dd class="col-sm-8"><code>@Html.DisplayFor(model => model.ISBN)</code></dd>

                        <dt class="col-sm-4 text-muted">
                            <i class="fas fa-user me-1"></i>Autor
                        </dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-info text-dark">
                                <i class="fas fa-user-edit me-1"></i>@Html.DisplayFor(model => model.NombreAutor)
                            </span>
                        </dd>

                        <dt class="col-sm-4 text-muted">
                            <i class="fas fa-copy me-1"></i>Ejemplares
                        </dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">
                                <i class="fas fa-layer-group me-1"></i>@Html.DisplayFor(model => model.Ejemplares) disponibles
                            </span>
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between">
                        <a asp-action="Edit" asp-route-id="@Model?.LibroId" class="btn btn-warning btn-sm">
                            <i class="fas fa-edit me-1"></i>Editar
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model?.LibroId" class="btn btn-danger btn-sm">
                            <i class="fas fa-trash me-1"></i>Eliminar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
